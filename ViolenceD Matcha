    vaultStatus.Position = Vector2.new(20, 300)
    vaultStatus.Transparency = 1
    vaultStatus.Visible = false
end)

local vaultCache, vaultCounts, vaultVals = nil, {}, {}
local vaultScanErr, vaultApplyErr, vaultSkipped = "", "", ""
local vaultLastSent, vaultLastScan, vaultNeedVerify = {}, 0, false
local vaultWasEnabled, vaultSprintHeld = false, false

local function vaultGetDesired()
    if VAULT.always then
        return { DISTANCE = 0.1, REPEAT_DISTANCE = 0.1, DOT = -1,
            MIN_SPEED = 0, ARRIVE_GRACE = 1, SIDESTEP_TIME = 5 }
    end
    return {
        DISTANCE = VAULT.dist, REPEAT_DISTANCE = VAULT.rdist, DOT = VAULT.dot,
        MIN_SPEED = VAULT.speed, ARRIVE_GRACE = VAULT.grace, SIDESTEP_TIME = VAULT.side,
    }
end

local function vaultScan()
    vaultLastScan = tick()
    local ok, result = pcall(getgc, VAULT_KEYS)
    vaultCounts, vaultVals = {}, {}
    if ok and type(result) == "table" then
        vaultCache, vaultScanErr = result, ""
        for _, entry in ipairs(result) do
            local okKey, key = pcall(function() return entry.key end)
            local okValue, value = pcall(function() return entry.value end)
            if okKey and key then
                vaultCounts[key] = (vaultCounts[key] or 0) + 1
                if vaultVals[key] == nil and okValue then vaultVals[key] = value end
            end
        end
    else
        vaultCache, vaultScanErr = nil, tostring(result)
    end
end

local function vaultSend(values, force)
    if not vaultCache then return end
    local send, skipped, count = {}, {}, 0
    for key, value in pairs(values) do
        local found = vaultCounts[key] or 0
        if found == 0 then
            skipped[#skipped + 1] = key .. "(none)"
        elseif force or vaultLastSent[key] ~= value then
            send[key] = value
            count = count + 1
        end
    end
    vaultSkipped = table.concat(skipped, " ")
    if count > 0 then
        local ok, err = pcall(applygc, vaultCache, send)
        if ok then
            vaultApplyErr = ""
            for key, value in pairs(send) do vaultLastSent[key] = value end
            if not force then vaultNeedVerify = true end
        else
            vaultApplyErr = tostring(err)
        end
    end
end

local function vaultFmt(value)
    if type(value) == "number" then return string.format("%.2f", value) end
    if value == nil then return "?" end
    return tostring(value)
end

local function vaultUpdateStatus()
    if not vaultStatus then return end
    if VAULT.debug and VAULT.enabled then
        local parts = {}
        for _, key in ipairs(VAULT_KEYS) do
            parts[#parts + 1] = key .. " x" .. (vaultCounts[key] or 0) .. "=" .. vaultFmt(vaultVals[key])
        end
        local line = table.concat(parts, "\n")
        if not vaultCache then line = "getgc FAILED: " .. vaultScanErr end
        if vaultSkipped ~= "" then line = line .. "\nskipped: " .. vaultSkipped end
        if vaultApplyErr ~= "" then line = line .. "\napplygc ERROR: " .. vaultApplyErr end
        vaultStatus.Text = line
        vaultStatus.Visible = true
    else
        vaultStatus.Visible = false
    end
end

local function vaultReleaseSprint()
    if vaultSprintHeld then
        pcall(keyrelease, VK_SHIFT)
        vaultSprintHeld = false
    end
end

local function vaultShutdown()
    if vaultWasEnabled and vaultCache then
        pcall(vaultSend, VAULT_DEFAULTS, true)
    end
    vaultReleaseSprint()
    if vaultStatus then
        pcall(function() vaultStatus.Visible = false end)
        pcall(function() vaultStatus:Remove() end)
        vaultStatus = nil
    end
end

-- The Matcha widget values are restored on reinjection; this loop only runs
-- the vault logic while its dedicated toggle is enabled.
task.spawn(function()
    local lastForce = 0
    while running do
        task.wait(0.2)
        local ok, err = pcall(function()
            local enabled = VAULT.enabled
            if enabled and (not vaultWasEnabled or not vaultCache or tick() - vaultLastScan > 60) then
                vaultScan()
                lastForce = 0
                vaultNeedVerify = true
            end
            if enabled then
                local force = tick() - lastForce > 5
                vaultSend(vaultGetDesired(), force)
                if force then lastForce = tick() end
            elseif vaultWasEnabled and vaultCache then
                vaultSend(VAULT_DEFAULTS, true)
                vaultLastSent = {}
            end
            vaultWasEnabled = enabled

            if vaultNeedVerify and enabled and tick() - vaultLastScan > 2 then
                vaultNeedVerify = false
                vaultScan()
            end

            local active = false
            if type(isrbxactive) == "function" then
                local activeOk, activeValue = pcall(isrbxactive)
                active = activeOk and activeValue == true
            end
            local wantSprint = enabled and VAULT.sprint and active
            if wantSprint and not vaultSprintHeld then
                pcall(keypress, VK_SHIFT)
                vaultSprintHeld = true
            elseif not wantSprint then
                vaultReleaseSprint()
            end
            vaultUpdateStatus()
        end)
        if not ok then
            if type(warn) == "function" then warn("[VaultMod] " .. tostring(err)) end
            task.wait(1)
        end
    end
    vaultShutdown()
end)

function API.unload()
    if not running then return end
    running = false
    scReleaseInput()
    pcall(vaultShutdown)
