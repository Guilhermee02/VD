}
local VAULT_KEYS = { "DISTANCE", "REPEAT_DISTANCE", "DOT", "MIN_SPEED", "ARRIVE_GRACE", "SIDESTEP_TIME" }
local VAULT = {
    enabled = false, always = false, sprint = false, debug = false,
    dist = 1.5, rdist = 1.5, dot = 0.2, speed = 6.0, side = 0.6, grace = 0.3,
}
